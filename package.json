{
  "name": "whitenoise",
  "version": "1.0.0",
  "private": true,
  "description": "Noise PWA + Capacitor Android",
  "scripts": {
    "www": "node scripts/prepare-www.mjs",
    "sync": "npm run www && npx cap sync android",
    "open": "npx cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "install:device": "npm run apk:debug && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@jofr/capacitor-media-session": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
